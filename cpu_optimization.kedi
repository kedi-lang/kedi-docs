```
import matplotlib.pyplot as plt
import numpy as np
from arch_search_utils import (
    Architecture, evaluate_architecture, random_architecture,
    nsga2_search
)
```

[pop_size: int] = `25`
[num_generations: int] = `8`

[pop_size_ga: int] = `100`
[num_generations_ga: int] = `100`

~City(name, population: int)

@propose_initial_designs() -> list[Architecture]:
    `print("\n=== LLM: Proposing initial designs ===")`
    You are designing a processor architecture. Propose <pop_size> diverse processor configurations. \
    Each configuration has: num_cores (1-16)\, cache_size_mb (1-64)\, frequency_ghz (1.0-5.0)\, bus_width (64/128/256/512)\, pipeline_depth (8-20). \
    Consider various design philosophies: high-core-count\, high-frequency\, balanced\, cache-focused\, etc. \
    [designs: list[Architecture]] is a list of <pop_size> diverse processor configurations.
    `print(f"Designs: {designs}")`
    = `designs`

@analyze_results(archs: list[Architecture], scores: list[float]) -> str:
    `print("\n=== LLM: Analyzing results ===")`
    [ranked: list] = ```
    return sorted(zip(archs, scores), key=lambda x: x[1], reverse=True)[:5]
    ```
    Analyze these top 5 processor architectures and their performance scores: \
    <`"\n".join([f"Score {s:.1f}: {a.to_string()}" for a, s in ranked])`> \
    What patterns do you notice? What design choices seem to work well? Provide 2-3 sentences. \
    [analysis: str]
    `print(f"Analysis: {analysis}")`
    = <analysis>

@propose_next_generation(best_archs: list[Architecture], analysis: str) -> list[Architecture]:
    `print("\n=== LLM: Proposing next generation ===")`
    [top_3: str] = `"\n".join([a.to_string() for a in best_archs[:3]])`
    Based on this analysis: <analysis> \
    And these top performers: <top_3> \
    [new_designs: list[Architecture]] is a list of <pop_size> new processor \
    configurations that build on successful patterns while exploring variations. 
    = `new_designs`

@llm_guided_search() -> tuple[list[Architecture], list[float]]:
    `print("\n" + "="*60)`
    `print("LLM-GUIDED EVOLUTIONARY SEARCH")`
    `print("="*60)`
    = ```
    best_per_gen = []
    best_scores = []
    
    # Initial population
    population = propose_initial_designs()
    
    for gen in range(num_generations):
        print(f"\nGeneration {gen + 1}/{num_generations}")
        
        # Evaluate
        scores = [evaluate_architecture(arch) for arch in population]
        
        # Track best
        best_idx = scores.index(max(scores))
        best_per_gen.append(population[best_idx])
        best_scores.append(scores[best_idx])
        
        print(f"  Best score: {scores[best_idx]:.2f}")
        print(f"  Best design: {population[best_idx].to_string()}")
        
        # Get top performers
        ranked = sorted(zip(population, scores), key=lambda x: x[1], reverse=True)
        top_archs = [a for a, s in ranked[:5]]
        
        # LLM analysis and next generation
        if gen < num_generations - 1:
            analysis = analyze_results(population, scores)
            population = propose_next_generation(top_archs, analysis)
    
    return (best_per_gen, best_scores)
    ```

@baseline_genetic_search() -> tuple[list[Architecture], list[float]]:
    `print("\n" + "="*60)`
    `print("BASELINE NSGA-II")`
    `print("="*60)`
    = ```
    best_per_gen, best_scores = nsga2_search(pop_size_ga, num_generations_ga)
    
    for gen, (arch, score) in enumerate(zip(best_per_gen, best_scores)):
        print(f"\nGeneration {gen + 1}/{num_generations_ga}")
        print(f"  Best score: {score:.2f}")
        print(f"  Best design: {arch.to_string()}")
    
    return (best_per_gen, best_scores)
    ```

@plot_comparison(llm_scores: list[float], ga_scores: list[float]):
    ```
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))
    
    # Normalize x-axes to [0,1] independently to superpose
    x_llm = np.linspace(0.0, 1.0, num=max(1, len(llm_scores)))
    x_ga = np.linspace(0.0, 1.0, num=max(1, len(ga_scores)))
    
    # Score evolution (normalized progress)
    ax1.plot(x_llm, llm_scores, 'b-o', linewidth=2, markersize=6, label='LLM-Guided')
    ax1.plot(x_ga, ga_scores, 'r-s', linewidth=2, markersize=5, label='NSGA-II')
    ax1.set_xlabel('Normalized Progress (0→1)', fontsize=12)
    ax1.set_ylabel('Best Score', fontsize=12)
    ax1.set_title('Optimization Progress', fontsize=14, fontweight='bold')
    ax1.legend(fontsize=11)
    ax1.grid(True, alpha=0.3)
    
    # Improvement over GA final (plot vs LLM normalized progress)
    baseline_final = ga_scores[-1]
    llm_improvement = [(s - baseline_final) / baseline_final * 100 for s in llm_scores]
    ax2.plot(x_llm, llm_improvement, 'g-o', linewidth=2, markersize=6)
    ax2.axhline(y=0, color='k', linestyle='--', alpha=0.5)
    ax2.set_xlabel('LLM Normalized Progress (0→1)', fontsize=12)
    ax2.set_ylabel('Improvement over NSGA-II Final (%)', fontsize=12)
    ax2.set_title('LLM-Guided Advantage', fontsize=14, fontweight='bold')
    ax2.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig('architecture_search_comparison.png', dpi=150, bbox_inches='tight')
    plt.close()
    
    print("\n" + "="*60)
    print(f"Plot saved: architecture_search_comparison.png")
    print("="*60)
    ```
    = done

@compare_final_results(llm_best: Architecture, llm_score: float, ga_best: Architecture, ga_score: float):
    ```
    print("\n" + "="*60)
    print("FINAL RESULTS COMPARISON")
    print("="*60)
    
    print("\n🤖 LLM-Guided Search:")
    print(f"   Score: {llm_score:.2f}")
    print(f"   Design: {llm_best.to_string()}")
    
    print("\n🧬 Genetic Algorithm:")
    print(f"   Score: {ga_score:.2f}")
    print(f"   Design: {ga_best.to_string()}")
    
    improvement = ((llm_score - ga_score) / ga_score * 100) if ga_score > 0 else 0
    
    print("\n📊 Performance:")
    if improvement > 0:
        print(f"   ✓ LLM-guided is {improvement:.1f}% better")
    elif improvement < 0:
        print(f"   ✗ LLM-guided is {abs(improvement):.1f}% worse")
    else:
        print(f"   = Tie")
    
    print("\n" + "="*60)
    ```
    = done

@run_comparison():
    [arch_result: Tuple] = `llm_guided_search()`
    [llm_archs:list] = `arch_result[0]`
    [llm_scores: list] = `arch_result[1]`
    #[ga_archs: list, ga_scores: list] = `baseline_genetic_search()`
    [ga_arch_result: Tuple] = `baseline_genetic_search()`
    [ga_archs: list] = `ga_arch_result[0]`
    [ga_scores: list] = `ga_arch_result[1]`

    <plot_comparison(`llm_scores`, `ga_scores`)>
    <compare_final_results(`llm_archs[-1]`, `llm_scores[-1]`, `ga_archs[-1]`, `ga_scores[-1]`)>
    = done

= <run_comparison()>